//let's drive some led, pin ?

/ {
	leds {
		redled: redled {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "RLED";
		};
		greenled: gled {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			label = "GLED";
		};
		blueled: blueled {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "BLED";
		};
	};
};